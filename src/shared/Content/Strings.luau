local function format(template: string, vars: { [string]: any }?, resolve: (string) -> string): string
	if not vars then
		return template
	end
	local values: { [string]: any } = vars
	return (
		string.gsub(template, "{(%w+)}", function(name)
			local value = values[name]
			if value == nil then
				return "{" .. name .. "}"
			end
			-- "@some.key" values are themselves localised (the server sends keys, not prose).
			if type(value) == "string" and string.sub(value, 1, 1) == "@" then
				return resolve(string.sub(value, 2))
			end
			return tostring(value)
		end)
	)
end

function Strings.languageFor(localeId: string?): "en" | "es"
	if localeId and string.sub(string.lower(localeId), 1, 2) == "es" then
		return "es"
	end
	return "en"
end

function Strings.get(language: string, key: string, vars: { [string]: any }?): string
	local tableForLanguage: { [string]: string } = if language == "es" then Strings.es else Strings.en
	local template = tableForLanguage[key] or Strings.en[key]
	if not template then
		return key
	end
	return format(template, vars, function(inner: string): string
		return Strings.get(language, inner, nil)
	end)
end

return Strings
