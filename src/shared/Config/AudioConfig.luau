--!strict
--[[
	Sound registry. CHANNEL 0 ships original sound files generated by `scripts/generate_audio.py`
	in `assets/audio/`. Roblox cannot load local files, so each file must be uploaded through the
	Creator Hub / Asset Manager and its id pasted here as "rbxassetid://<number>".

	Until an id is set the game keeps working: optional sounds are skipped silently and every
	spoken/broadcast line is also delivered as a subtitle. Sounds marked `essential` are reported
	by the test runner and by AudioController at startup (Studio only) so they are not forgotten.
]]

export type SoundDef = {
	id: string,
	volume: number,
	looped: boolean,
	essential: boolean,
	group: "Ambience" | "Signal" | "Anchor" | "Interface" | "World" | "Stinger" | "Voice",
	-- Positional sounds use these roll-off distances (studs).
	rolloffMin: number?,
	rolloffMax: number?,
	playbackSpeed: number?,
	file: string, -- name of the generated source file in assets/audio
}

local AudioConfig = {}

local function def(
	file: string,
	group: any,
	volume: number,
	looped: boolean,
	essential: boolean,
	rolloffMin: number?,
	rolloffMax: number?
): SoundDef
	return {
		id = "",
		file = file,
		group = group,
		volume = volume,
		looped = looped,
		essential = essential,
		rolloffMin = rolloffMin,
		rolloffMax = rolloffMax,
	}
end

